# Copy this file to .env and fill in real values. NEVER commit .env itself.

# --- LLM backend: "ollama" (local, default) or "openrouter" (hosted) ---
LLM_BACKEND=ollama

# Ollama (no key needed, requires `ollama serve` running + model pulled)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# OpenRouter (only used if LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embedding backend: "ollama" (local, default), "voyage", or "local" ---
EMBEDDING_BACKEND=ollama

# Ollama embedding model (pull with: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Voyage AI (only used if EMBEDDING_BACKEND=voyage, requires card, 200M free tokens)
VOYAGE_API_KEY=

# --- Paths ---
ARCHIVE_RAW_DIR=data/raw
ARCHIVE_PROCESSED_DIR=data/processed
ARCHIVE_VISUALS_DIR=data/visuals
CHROMA_PERSIST_DIR=data/processed/chroma_db
